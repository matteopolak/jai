// Direct3D 12 bindings.
#module_parameters ()(INCLUDE_DEBUG_BINDINGS := false);
WKPDID_D3DDebugObjectName :: "429b8c22-9188-4b0c-8742-acb0bf85c200";
D3D12_ENCODE_SHADER_4_COMPONENT_MAPPING :: (Src0: s32, Src1: s32, Src2: s32, Src3: s32) -> D3D12_SHADER_COMPONENT_MAPPING {
    encoded := D3D12_SHADER_COMPONENT_MAPPING_ALWAYS_SET_BIT_AVOIDING_ZEROMEM_MISTAKES;
    lanes: [4] s32;
    lanes[0] = Src0;
    lanes[1] = Src1;
    lanes[2] = Src2;
    lanes[3] = Src3;
    for lane: 0..3 encoded |= (lanes[lane] & D3D12_SHADER_COMPONENT_MAPPING_MASK) << (lane * D3D12_SHADER_COMPONENT_MAPPING_SHIFT);
    return cast(D3D12_SHADER_COMPONENT_MAPPING) encoded;
}
D3D12_DECODE_SHADER_4_COMPONENT_MAPPING :: (ComponentToExtract: s32, Mapping: s32) -> D3D12_SHADER_COMPONENT_MAPPING {
    bits := Mapping >> (ComponentToExtract * D3D12_SHADER_COMPONENT_MAPPING_SHIFT);
    return cast(D3D12_SHADER_COMPONENT_MAPPING) (bits & D3D12_SHADER_COMPONENT_MAPPING_MASK);
}
D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING :: () -> D3D12_SHADER_COMPONENT_MAPPING {
    return D3D12_ENCODE_SHADER_4_COMPONENT_MAPPING(0, 1, 2, 3);
}
D3D12_ENCODE_BASIC_FILTER :: (min: D3D12_FILTER_TYPE, mag: D3D12_FILTER_TYPE, mip: D3D12_FILTER_TYPE, reduction: D3D12_FILTER_REDUCTION_TYPE) -> D3D12_FILTER {
    filter := ((cast(s32) min) & D3D12_FILTER_TYPE_MASK) << D3D12_MIN_FILTER_SHIFT;
    filter |= ((cast(s32) mag) & D3D12_FILTER_TYPE_MASK) << D3D12_MAG_FILTER_SHIFT;
    filter |= ((cast(s32) mip) & D3D12_FILTER_TYPE_MASK) << D3D12_MIP_FILTER_SHIFT;
    filter |= ((cast(s32) reduction) & D3D12_FILTER_REDUCTION_TYPE_MASK) << D3D12_FILTER_REDUCTION_TYPE_SHIFT;
    return cast(D3D12_FILTER) filter;
}
D3D12_ENCODE_ANISOTROPIC_FILTER :: (reduction: D3D12_FILTER_REDUCTION_TYPE) -> D3D12_FILTER {
    basic := D3D12_ENCODE_BASIC_FILTER(.LINEAR, .LINEAR, .LINEAR, reduction);
    return cast(D3D12_FILTER) ((cast(s32) basic) | D3D12_ANISOTROPIC_FILTERING_BIT);
}
D3D12_DECODE_MIN_FILTER :: (D3D12Filter: D3D12_FILTER) -> D3D12_FILTER_TYPE {
    return cast(D3D12_FILTER_TYPE) (((cast(s32) D3D12Filter) >> D3D12_MIN_FILTER_SHIFT) & D3D12_FILTER_TYPE_MASK);
}
D3D12_DECODE_MAG_FILTER :: (D3D12Filter: D3D12_FILTER) -> D3D12_FILTER_TYPE {
    return cast(D3D12_FILTER_TYPE) (((cast(s32) D3D12Filter) >> D3D12_MAG_FILTER_SHIFT) & D3D12_FILTER_TYPE_MASK);
}
D3D12_DECODE_MIP_FILTER :: (D3D12Filter: D3D12_FILTER) -> D3D12_FILTER_TYPE {
    return cast(D3D12_FILTER_TYPE) (((cast(s32) D3D12Filter) >> D3D12_MIP_FILTER_SHIFT) & D3D12_FILTER_TYPE_MASK);
}
D3D12_DECODE_FILTER_REDUCTION :: (D3D12Filter: D3D12_FILTER) -> D3D12_FILTER_REDUCTION_TYPE {
    return cast(D3D12_FILTER_REDUCTION_TYPE) (((cast(s32) D3D12Filter) >> D3D12_FILTER_REDUCTION_TYPE_SHIFT) & D3D12_FILTER_REDUCTION_TYPE_MASK);
}
D3D12_DECODE_IS_COMPARISON_FILTER :: (D3D12Filter: D3D12_FILTER) -> bool {
    return D3D12_DECODE_FILTER_REDUCTION(D3D12Filter) == .COMPARISON;
}
D3D12_DECODE_IS_ANISOTROPIC_FILTER :: (D3D12Filter: D3D12_FILTER) -> bool {
    if ((cast(s32) D3D12Filter) & D3D12_ANISOTROPIC_FILTERING_BIT) == 0 return false;
    return D3D12_DECODE_MIN_FILTER(D3D12Filter) == .LINEAR && D3D12_DECODE_MAG_FILTER(D3D12Filter) == .LINEAR;
}
