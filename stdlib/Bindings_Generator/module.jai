// Bindings_Generator: turns C, C++ and Objective-C headers into Jai declarations.
//
// The public surface follows the reference module: fill in a
// `Generate_Bindings_Options`, optionally install a `visitor`, then call
// `generate_bindings`. Headers are parsed with the host libclang through the
// bridge in clang.jai. See docs/stdlib/bindings-generator.md.

// The OS whose bindings are generated by default (`Generate_Bindings_Options.os`).
#module_parameters (TARGET_OS_AS_INT : int = xx OS);

TARGET_OS : type_of(OS) : xx TARGET_OS_AS_INT;

#import "Basic";
#import "String";
#import "File";
#import "Hash_Table";
#import "Process";
#import "Toolchains/macOS";
#import "Toolchains/Android";

#load "clang.jai";
#load "types.jai";
#load "convert.jai";
#load "print.jai";
#load "generate.jai";
#load "api.jai";
