// SDL2 declarations from SDL_keyboard.h.
SDL_SCANCODE_TO_KEYCODE :: (scancode: SDL_Scancode) -> s32 {
    value := cast(s32) scancode;
    value |= 0x40000000;
    return value;
}

Hack :: struct {
    K :: (scancode: SDL_Scancode) -> s32 {
        return SDL_SCANCODE_TO_KEYCODE(scancode);
    }
}

